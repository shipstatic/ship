#!/bin/sh
# Fast gate only — the full suite lives in CI (the workflow's test job).

# No ship-/deploy- credential may enter history (the repeating fake test key
# is excluded). Scans added lines of staged files.
LEAKS=$(git diff --cached --no-color --unified=0 --diff-filter=ACMR \
  | grep -E '^\+' | grep -E '(ship|deploy)-[0-9a-f]{64}' \
  | grep -v '1234567890abcdef' || true)
if [ -n "$LEAKS" ]; then
  echo "credential detected in staged changes:" >&2
  echo "$LEAKS" >&2
  exit 1
fi

pnpm exec biome check --staged --no-errors-on-unmatched
pnpm typecheck
