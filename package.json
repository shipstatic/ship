{
  "name": "@shipstatic/ship",
  "version": "2.8.0",
  "description": "SDK & CLI for ShipStatic platform",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/browser.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": "./dist/cli.cjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "ship": "./dist/cli.cjs"
  },
  "scripts": {
    "test": "vitest --project unit --project integration",
    "test:unit": "vitest --project unit",
    "test:integration": "vitest --project integration",
    "test:e2e": "vitest --project e2e",
    "test:ci": "vitest --run --project unit --project integration",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "clean": "rm -rf dist build-meta",
    "build": "pnpm run clean && tsup && node scripts/post-build.cjs && node scripts/third-party-licenses.cjs",
    "prepack": "pnpm run build",
    "prepare": "git config core.hooksPath scripts/githooks",
    "lint": "biome check .",
    "format": "biome format --write .",
    "coverage": "vitest --run --project unit --project integration --coverage",
    "check:package": "publint && attw --pack . --exclude-entrypoints cli",
    "test:browser": "vitest --run --project browser"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "THIRD-PARTY-LICENSES.md"
  ],
  "keywords": [
    "ai",
    "cli",
    "custom-domain",
    "deploy",
    "developer-tools",
    "hosting",
    "jamstack",
    "sdk",
    "ship",
    "static-hosting",
    "static-site",
    "typescript",
    "vibe-coding",
    "web-hosting",
    "website"
  ],
  "homepage": "https://github.com/shipstatic/ship",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipstatic/ship.git"
  },
  "bugs": {
    "url": "https://github.com/shipstatic/ship/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "ShipStatic",
  "license": "MIT",
  "sideEffects": false,
  "dependencies": {
    "junk": "^4.0.1",
    "spark-md5": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.5",
    "@shipstatic/types": "2.21.0",
    "@types/columnify": "^1.5.4",
    "@types/node": "^20.19.43",
    "@types/spark-md5": "^3.0.5",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "columnify": "^1.6.0",
    "commander": "^14.0.3",
    "fast-check": "^4.9.0",
    "jsdom": "^24.1.3",
    "playwright": "1.62.0",
    "publint": "^0.3.22",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "4.1.10",
    "yocto-spinner": "^1.2.2",
    "yoctocolors": "^2.2.0"
  },
  "packageManager": "pnpm@10.12.4",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
